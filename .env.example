# Copy to .env and fill in. Never commit .env.
#
# BOT_TOKEN and SECRET_KEY are best NOT kept in this file or in the environment at all: with Docker
# they are read from secret files (see docker-compose.yml). Uncomment them to run without Docker.
#
# From @BotFather
# BOT_TOKEN=
#
# Master secret, at least 32 characters. The pseudonymous ids and the keys that protect every
# user's data derive from it, so it must NEVER change for existing databases (the bot refuses to
# start with another key). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# The (encrypted) data, and the keys that decrypt it. Two files, on purpose: see README, "Backups".
DATABASE_PATH=data/blakkisvuohi.sqlite3
KEY_DATABASE_PATH=data/keys.sqlite3

# Everything older than this many days is deleted by the daily purge. Accounts that have not been
# used for ACCOUNT_RETENTION_DAYS (default: the same) are deleted completely.
RETENTION_DAYS=7
# ACCOUNT_RETENTION_DAYS=7
# Local hour (in TIMEZONE) of the daily purge
PURGE_HOUR=12

# Telegram user id of the admin (enables /admin_stats /admin_loglevel /admin_purge). Empty for none.
ADMIN_ID=

TIMEZONE=Europe/Helsinki
LOG_LEVEL=INFO

# polling (default) or webhook
BOT_MODE=polling

# --- webhook mode only ---
# Public https address of the bot. The bot registers <WEBHOOK_URL>/webhook/<derived secret path>
WEBHOOK_URL=
# 16-256 characters of A-Z a-z 0-9 _ -. Telegram sends it with every update and the bot rejects
# requests without it. Can be a secret file too (webhook_secret).
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080
